[Unit]
Description=Atipicial N3 Rust node (atipicial-node)
Documentation=https://github.com/r3e-network/atipicial-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/Group and paths to your deployment. The binary is built with
#   cargo build --release -p atipicial-node --features wip
# and installed to /usr/local/bin/atipicial-node.
User=atipicial
Group=atipicial
ExecStart=/usr/local/bin/atipicial-node --config /etc/atipicial/atipicial_mainnet_node.toml
Restart=on-failure
RestartSec=5
# Persistent data directory (also set [storage].data_dir / .path in the TOML).
StateDirectory=atipicial
WorkingDirectory=/var/lib/atipicial
Environment=RUST_LOG=info
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
